# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SUPER_ADMIN_EMAIL: Primary Super Admin email allowed to auto-provision SuperAdmin privileges on sign-in.
SUPER_ADMIN_EMAIL=

# Payment Gateway Merchant Credentials (Server-Side Only)
BKASH_APP_KEY=
BKASH_APP_SECRET=
NAGAD_MERCHANT_ID=
ROCKET_MERCHANT_ID=
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=

# Notification & Password Recovery Email Credentials (Server-Side Only)
SMTP_HOST=
SMTP_USER=
SMTP_PASS=
SMS_API_KEY=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
